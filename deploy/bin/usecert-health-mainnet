#!/usr/bin/env python3
"""Mainnet health for the France host: the things that stop a mint or a redemption, and nothing else.

    usecert-health-mainnet            check, alert on a change of state, exit 1 while anything is wrong
    usecert-health-mainnet --summary  also send the full state even when nothing changed (daily timer)

WHAT IS CHECKED, and why each one matters to a holder:
  signer     127.0.0.1:8787/attestations answers HEAD 200. If it stops, no mint can open capacity.
  units      the signer and every stack-4 keeper are active. A dead keeper leaves mints in escrow.
  progress   each keeper's scan is within LAG_BLOCKS of the head. A stuck scanner is a dead keeper
             that systemd still calls "active".
  receipts   no receipt in a keeper journal sits in a state that needs a human
             (*_needs_human, order_refused), and none is still "placing"/"placed" after STUCK_SEC.
  gas        the attester (which sends settleMint and recallMarginUpTo) and the deployer hold at
             least MIN_ETH. Out of gas, the keeper fills on the venue and cannot settle on chain.
  site       https://use-cert.com/ returns 200.
  backup     the nightly encrypted copy to Montreal succeeded within 36 h.
  indexer    all six vault event files were rewritten within 5 min.
  book       every address this host runs on matches the book tracked on GitHub.
  manifest   every deployed file equals its blob on GitHub (usecert-release-manifest).
  insurance  no draw is pending on the insurance pool (a pending draw pauses stakers' exits).

What is NOT checked: attestation age. Between mints it is stale and capacity reads zero BY DESIGN
(the signer signs, the minter relays); alerting on it describes correct behaviour.

Alerts go to Telegram when /etc/usecert/telegram.env sets TG_TOKEN and TG_CHAT, otherwise to the
journal only. An alert is sent when the set of problems CHANGES (new problem, or all clear), not
every run, so a standing fault does not turn into noise nobody reads.
"""
import glob
import json
import os
import subprocess
import sys
import time
import urllib.request

RPC = "https://rpc.mainnet.chain.robinhood.com"
SIGNER = "http://127.0.0.1:8787/attestations"
SITE = "https://use-cert.com/"
BOOK = "/opt/keeper/book-stack4.json"
STATE_GLOB = "/opt/keeper/state-s4-*.json"
UNITS = ["usecert-signer-mainnet"] + ["usecert-keeper@s4-%s" % s for s in ("uTSLA", "uSPY", "uQQQ", "uNVDA", "uAAPL", "uMSFT")]
LAG_BLOCKS = 3000        # the keepers poll every few seconds; this is minutes of silence, not jitter
STUCK_SEC = 900          # a hedge normally fills in under a minute; fill_timeout_sec is 180
MIN_ETH = 0.002
MEMO = "/var/lib/usecert-health/mainnet.json"
BACKUP_STAMP = "/var/lib/usecert-backup/last-ok"
INDEX_GLOB = "/var/www/usecert-data/logs/*.json"
TRACKED_BOOK_URL = "https://raw.githubusercontent.com/UseCert/usecert/backend/contracts-c1/deployments/4663.json"
MANIFEST = "/var/www/usecert-data/manifest.json"
INSURANCE_BOOK = "/opt/usecert-history/4663.insurance.json"
SIDE_BOOKS = "/opt/usecert-history/4663.*.json"
CERT_STAKING_BOOK = "/opt/usecert-history/4663.certstaking.json"
HOST_BOOKS = ["/opt/keeper/book-stack4.json", "/opt/usecert-history/4663.json"]
MAIL_HOST = "mx.use-cert.com"
UA = {"User-Agent": "usecert-health/1.0", "Content-Type": "application/json"}


def rpc(method, params):
    # The six keepers share this public RPC and it answers 429 under load. Back off rather than
    # report the rate limit as a fault; only a failure that survives the retries is one.
    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode()
    for attempt in range(5):
        try:
            with urllib.request.urlopen(urllib.request.Request(RPC, body, UA), timeout=20) as r:
                out = json.load(r)
            break
        except urllib.error.HTTPError as e:
            if e.code not in (429, 502, 503, 504) or attempt == 4:
                raise
            time.sleep(2 * 2 ** attempt)
    if "error" in out:
        raise RuntimeError(out["error"])
    return out["result"]


def status_of(url, method="GET"):
    try:
        with urllib.request.urlopen(urllib.request.Request(url, method=method, headers={"User-Agent": UA["User-Agent"]}), timeout=15) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code
    except Exception as e:
        return "unreachable (%s)" % type(e).__name__


def checks():
    P = []
    s = status_of(SIGNER, "HEAD")
    if s != 200:
        P.append("signer: HEAD %s -> %s (no in-date signatures: mints cannot open capacity)" % (SIGNER, s))

    for u in UNITS:
        st = subprocess.run(["systemctl", "is-active", u], capture_output=True, text=True).stdout.strip()
        if st != "active":
            P.append("unit %s is %s" % (u, st or "unknown"))

    try:
        head = int(rpc("eth_blockNumber", []), 16)
    except Exception as e:
        head = None
        P.append("rpc: eth_blockNumber failed (%s)" % str(e)[:80])

    now = time.time()
    states = sorted(glob.glob(STATE_GLOB))
    if len(states) != 6:
        P.append("keeper journals: found %d of 6 (%s)" % (len(states), STATE_GLOB))
    for f in states:
        sym = os.path.basename(f)[len("state-s4-"):-len(".json")]
        try:
            st = json.load(open(f))
        except Exception as e:
            P.append("%s: journal unreadable (%s)" % (sym, type(e).__name__))
            continue
        if head is not None and head - int(st.get("next_block", 0)) > LAG_BLOCKS:
            P.append("%s: keeper scan is %d blocks behind the head" % (sym, head - int(st["next_block"])))
        for rid, rec in st.get("receipts", {}).items():
            status = rec.get("status", "?")
            age = now - float(rec.get("at", now))
            if status.endswith("_needs_human") or status == "order_refused":
                P.append("%s receipt %s: %s" % (sym, rid, status))
            elif status in ("placing", "placed") and age > STUCK_SEC:
                P.append("%s receipt %s: still '%s' after %d min" % (sym, rid, status, age // 60))

    try:
        senders = json.load(open(BOOK))["senders"]
        for name in ("attester", "deployer"):
            wei = int(rpc("eth_getBalance", [senders[name], "latest"]), 16)
            if wei < MIN_ETH * 1e18:
                P.append("gas: %s %s holds %.5f ETH (< %s)" % (name, senders[name], wei / 1e18, MIN_ETH))
    except Exception as e:
        P.append("gas: balances unreadable (%s)" % str(e)[:80])

    s = status_of(SITE)
    if s != 200:
        P.append("site: %s -> %s" % (SITE, s))

    # The dashboard's activity and receipts read these first; stale means the site falls back
    # to the explorer silently, so it is the indexer's own freshness that is checked here.
    try:
        ages = [now - json.load(open(f))["indexer"]["generatedAt"] for f in glob.glob(INDEX_GLOB)]
        if len(ages) != 6:
            P.append("indexer: %d of 6 vault files present (%s)" % (len(ages), INDEX_GLOB))
        elif max(ages) > 300:
            P.append("indexer: vault files last written %d min ago (usecert-indexer)" % (max(ages) // 60))
    except (OSError, ValueError, KeyError) as e:
        P.append("indexer: files unreadable (%s)" % type(e).__name__)

    # ROADMAP 6.22, twice: the stack went live with its book only on this host while the
    # tracked copy described an older stack. Compare every address the host runs on with the
    # book tracked on GitHub. A mismatch is a problem; GitHub being unreachable is not (it is
    # checked again in five minutes and says nothing about the chain).
    try:
        req = urllib.request.Request(TRACKED_BOOK_URL, headers={"User-Agent": UA["User-Agent"]})
        with urllib.request.urlopen(req, timeout=20) as r:
            tracked = json.load(r)
        def addrs(book):
            out = {("shared", k): str(v).lower() for k, v in book.get("shared", {}).items() if str(v).startswith("0x")}
            for v in book.get("vaults", []):
                for k, x in v.items():
                    if isinstance(x, str) and x.startswith("0x") and len(x) == 42:
                        out[(v.get("symbol"), k)] = x.lower()
            out[("senders", "governance")] = str(book.get("senders", {}).get("governance", "")).lower()
            return out
        for local in HOST_BOOKS:
            mine, theirs = addrs(json.load(open(local))), addrs(tracked)
            diff = sorted(k for k in set(mine) | set(theirs) if mine.get(k) != theirs.get(k))
            if diff:
                P.append("book drift: %s differs from the tracked deployments/4663.json at %d address(es), e.g. %s"
                         % (local, len(diff), "/".join(map(str, diff[0]))))
    except (urllib.error.URLError, TimeoutError, ValueError) as e:
        print("book drift check skipped: %s" % type(e).__name__)

    # The side books (4663.insurance.json, 4663.certstaking.json, and any future 4663.<x>.json)
    # are compared too: every address in each host copy must match the copy on GitHub, and a book
    # the host has but GitHub does not (404) is the "deployed but never committed" case itself.
    def all_addrs(x, path=""):
        if isinstance(x, dict):
            return {k2: v2 for k, v in x.items() for k2, v2 in all_addrs(v, path + "/" + k).items()}
        if isinstance(x, list):
            return {k2: v2 for i, v in enumerate(x) for k2, v2 in all_addrs(v, "%s[%d]" % (path, i)).items()}
        return {path: x.lower()} if isinstance(x, str) and x.startswith("0x") and len(x) == 42 else {}
    for local in sorted(glob.glob(SIDE_BOOKS)):
        name = os.path.basename(local)
        try:
            req = urllib.request.Request(TRACKED_BOOK_URL.rsplit("/", 1)[0] + "/" + name, headers={"User-Agent": UA["User-Agent"]})
            with urllib.request.urlopen(req, timeout=20) as r:
                theirs = all_addrs(json.load(r))
            mine = all_addrs(json.load(open(local)))
            diff = sorted(k for k in set(mine) | set(theirs) if mine.get(k) != theirs.get(k))
            if diff:
                P.append("book drift: %s differs from the tracked deployments/%s at %d address(es), e.g. %s" % (local, name, len(diff), diff[0]))
        except urllib.error.HTTPError as e:
            if e.code == 404:
                P.append("book drift: %s is deployed on this host but deployments/%s is not on GitHub - commit it" % (local, name))
        except (urllib.error.URLError, TimeoutError, ValueError) as e:
            print("side book check skipped for %s: %s" % (name, type(e).__name__))

    # usecert-release-manifest (hourly): does what runs here equal what is public on GitHub?
    try:
        man = json.load(open(MANIFEST))
        if now - man["generatedAt"] > 3 * 3600:
            P.append("manifest: not regenerated for %d h (usecert-release-manifest)" % ((now - man["generatedAt"]) // 3600))
        elif not man["allMatch"]:
            bad = [f["host"] for f in man["files"] if not f["matches"]] + man["web"].get("differ", []) + man["web"].get("onlyInRepo", [])
            P.append("manifest: running code differs from GitHub: %s" % ", ".join(bad[:5]))
    except (OSError, ValueError, KeyError) as e:
        P.append("manifest: unreadable (%s)" % type(e).__name__)

    # The insurance pool (K1). A proposed draw is the one event stakers most need to hear about
    # quickly: exits pause until it executes, is cancelled or expires. Reported while pending.
    try:
        pool = json.load(open(INSURANCE_BOOK))["address"]
        call = lambda sel: rpc("eth_call", [{"to": pool, "data": sel}, "latest"])
        if int(call("0x6060ffaa"), 16) != 0:
            P.append("insurance: a draw is PENDING on the pool %s (%d proposed ever, pool holds %.2f USDG) - exits and deposits are paused"
                     % (pool, int(call("0x08222d58"), 16), int(call("0x01e1d114"), 16) / 1e6))
    except FileNotFoundError:
        pass
    except Exception as e:                                       # noqa: BLE001
        P.append("insurance: pool unreadable (%s)" % str(e)[:80])

    # Both staking pools. Solvency is checked against what each pool must be able to pay, read
    # from the chain (tokens included, nothing hard-coded). A cap close to full is reported early,
    # because raising it means deploying a new pool. A reward stream that has simply ended is NOT
    # a problem: rewards are funded by hand until K2, so "nothing streaming" is the normal state.
    word = lambda to, data: int(rpc("eth_call", [{"to": to, "data": data}, "latest"]), 16)
    bal = lambda token, who: word(token, "0x70a08231" + "0" * 24 + who[2:].lower())
    try:
        cs = json.load(open(CERT_STAKING_BOOK))["address"]
    except FileNotFoundError:
        cs = None
    except Exception as e:                                       # noqa: BLE001
        cs = None
        P.append("cert staking: book unreadable (%s)" % str(e)[:80])
    if cs:
        try:
            cert_t = "0x" + ("%064x" % word(cs, "0x72f702f3"))[-40:]
            usdg_t = "0x" + ("%064x" % word(cs, "0xf7c618c1"))[-40:]
            staked, cap = word(cs, "0x817b1cd2"), word(cs, "0xba28fd2e")
            owed = word(cs, "0xe1c4c9fe") + word(cs, "0xdf1c455c")      # still to stream + carried
            held_cert, held_usdg = bal(cert_t, cs), bal(usdg_t, cs)
            if held_cert < staked:
                P.append("cert staking: INSOLVENT - holds %.2f CERT but %.2f is staked (%s)" % (held_cert / 1e18, staked / 1e18, cs))
            if held_usdg < owed:
                P.append("cert staking: reward stream underfunded - holds %.6f USDG, owes %.6f still to stream (%s)" % (held_usdg / 1e6, owed / 1e6, cs))
            if cap and staked * 10 >= cap * 9:
                P.append("cert staking: %.0f%% of the %.0f CERT stake cap is used - raising it means a new pool" % (100.0 * staked / cap, cap / 1e18))
        except Exception as e:                                   # noqa: BLE001
            P.append("cert staking: pool unreadable (%s)" % str(e)[:80])
    try:
        pool = json.load(open(INSURANCE_BOOK))["address"]
        held, cap = word(pool, "0x01e1d114"), word(pool, "0xdbd5edc7")
        if cap and held * 10 >= cap * 9:
            P.append("insurance: %.0f%% of the %.0f USDG deposit cap is used - raising it means a new pool" % (100.0 * held / cap, cap / 1e6))
    except FileNotFoundError:
        pass
    except Exception as e:                                       # noqa: BLE001
        P.append("insurance: cap unreadable (%s)" % str(e)[:80])

    # usecert-backup-france writes this after Montreal confirms the byte count.
    try:
        age_h = (now - int(open(BACKUP_STAMP).read().strip())) / 3600
        if age_h > 36:
            P.append("backup: last encrypted copy to Montreal is %.0f h old (usecert-backup-france)" % age_h)
    except (OSError, ValueError):
        P.append("backup: no successful encrypted copy to Montreal on record (%s)" % BACKUP_STAMP)
    # Mail for use-cert.com (moved here from Montreal 2026-09-26). Falsifiable: connect by NAME,
    # verify the certificate for that name, and read each daemon's greeting - a stopped dovecot,
    # an expired or wrong certificate, or a queue that stopped draining all fail loudly here.
    try:
        import smtplib, socket, ssl
        ctx = ssl.create_default_context()
        s = smtplib.SMTP(MAIL_HOST, 25, timeout=15)
        if not s.ehlo()[1].decode().startswith(MAIL_HOST):
            P.append("mail: SMTP on %s:25 answers as someone else" % MAIL_HOST)
        s.starttls(context=ctx)
        left = (ssl.cert_time_to_seconds(s.sock.getpeercert()["notAfter"]) - now) / 86400
        s.quit()
        if left < 14:
            P.append("mail: the %s certificate expires in %.0f days (renewal hook reload-mail)" % (MAIL_HOST, left))
        with ctx.wrap_socket(socket.create_connection((MAIL_HOST, 993), timeout=15), server_hostname=MAIL_HOST) as t:
            if not t.recv(200).startswith(b"* OK"):
                P.append("mail: IMAP on %s:993 did not greet" % MAIL_HOST)
        q = [json.loads(l) for l in subprocess.run(["postqueue", "-j"], capture_output=True, text=True, timeout=20).stdout.splitlines() if l.strip()]
        old = [m for m in q if now - m.get("arrival_time", now) > 3600]
        if len(q) > 20 or old:
            P.append("mail: %d queued, %d older than 1 h - delivery is not draining (postqueue -p)" % (len(q), len(old)))
    except Exception as e:                                       # noqa: BLE001
        P.append("mail: %s unreachable or invalid (%s: %s)" % (MAIL_HOST, type(e).__name__, str(e)[:80]))
    return P


def env():
    try:
        return dict(l.strip().split("=", 1) for l in open("/etc/usecert/telegram.env") if "=" in l and not l.startswith("#"))
    except OSError:
        return {}


def notify(text):
    print(text)
    e = env()
    tok, chat = e.get("TG_TOKEN", "").strip('"'), e.get("TG_CHAT", "").strip('"')
    if not tok or not chat:
        return
    body = json.dumps({"chat_id": chat, "text": text, "disable_web_page_preview": True}).encode()
    try:
        urllib.request.urlopen(urllib.request.Request("https://api.telegram.org/bot%s/sendMessage" % tok, body,
                                                      {"Content-Type": "application/json"}), timeout=20)
    except Exception as ex:
        print("telegram send failed: %s" % type(ex).__name__)


def main():
    host = os.uname().nodename
    P = checks()
    try:
        before = json.load(open(MEMO))["problems"]
    except (OSError, ValueError, KeyError):
        before = None
    os.makedirs(os.path.dirname(MEMO), exist_ok=True)
    json.dump({"at": int(time.time()), "problems": P}, open(MEMO, "w"), indent=1)

    if P and P != before:
        notify("UseCert mainnet [%s]: %d problem(s)\n- %s" % (host, len(P), "\n- ".join(P)))
    elif not P and before:
        notify("UseCert mainnet [%s]: all clear (signer, 6 keepers, journals, gas, site)" % host)
    elif "--summary" in sys.argv:
        notify("UseCert mainnet [%s] daily: %s" % (host, "OK - signer, 6 keepers, journals, gas, site" if not P else "- " + "\n- ".join(P)))
    else:
        print("ok" if not P else "unchanged: %d problem(s)" % len(P))
    sys.exit(1 if P else 0)


if __name__ == "__main__":
    main()
