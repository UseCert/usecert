#!/usr/bin/env python3
"""Montreal: the stack-5 SETTLER, kept apart from the venue API keys on France (Sermium M-03).

    usecert-settler-remote intake      the ONLY command France's settle key can run (forced in
                                       authorized_keys): one request on stdin, one answer out
    usecert-settler-remote serve       the loop that holds the settler key (systemd)
    usecert-settler-remote check ...   dry: run the checks for one request and print the verdict

WHY. In keeper mode settleMint mints certificates on the settler's word, and the venue API key
can trade the vault's whole account. With both keys on one host, whoever takes that host can mint
certificates with no hedge behind them. So the France keeper keeps the API keys and places the
orders, and asks THIS process to send every transaction the settler key used to send. Before
settleMint it reads, itself, from the chain and from the venue's public account endpoint (a read,
which the venue allows from here; orders are never sent from here), and refuses unless:

  settleMint(rid, fillPx18)   the receipt exists, is open and inside its settle window; the fill
                              price is inside the vault's settle band of the request price; and
                              the vault's venue position covers every certificate that will exist
                              once it settles: position >= (supply + indicativeCerts) x M, less
                              POSITION_TOL_UNITS venue units. Also a daily notional budget.
  rehedge(maxBase)            the public position is short of supply x M by at least maxBase.
  recallMarginUpTo, stageRefund, refundMint
                              permissionless on chain (the settler key only pays the gas); only
                              the rate limit applies.

A France compromise can then still trade the account (it cannot withdraw it) but can no longer
issue unbacked certificates. Every request and verdict is logged; nothing is retried here: the
keeper decides what to ask again.

Files: requests land in INBOX as <id>.json (written by intake), answers in OUTBOX/<id>.json
(written by serve). The two run as different users; the key is only in serve's environment
(SETTLER_PK, from a root-only EnvironmentFile), never on a command line.
"""
import json
import os
import re
import secrets
import sys
import time
import urllib.error
import urllib.request
from decimal import Decimal

RPC = os.environ.get("RPC_URL", "https://rpc.mainnet.chain.robinhood.com")
API = os.environ.get("VENUE_API", "https://api.rh.lighter.xyz")
BOOK = os.environ.get("STACK5_BOOK", "/opt/usecert/deployments/4663.stack5.json")
BASE = os.environ.get("SETTLER_DIR", "/var/lib/usecert-settler")
INBOX, OUTBOX = os.path.join(BASE, "inbox"), os.path.join(BASE, "outbox")
LEDGER = os.path.join(BASE, "ledger.json")
CHAIN_ID = 4663
POSITION_TOL_UNITS = int(os.environ.get("POSITION_TOL_UNITS", "2"))
DAILY_SETTLE_USD = Decimal(os.environ.get("DAILY_SETTLE_USD", "5000"))
MAX_SENDS_PER_HOUR = int(os.environ.get("MAX_SENDS_PER_HOUR", "60"))
ANSWER_WAIT_SEC = 170
UA = {"User-Agent": "usecert-settler/1.0", "Content-Type": "application/json"}

ACTIONS = {
    "settleMint(uint256,uint256)": ("0x778048a0", 2),
    "rehedge(uint256)": ("0x68b578b2", 1),
    "recallMarginUpTo(uint256)": ("0xc7d1f5ce", 1),
    "stageRefund(uint256)": ("0xe571c72c", 1),
    "refundMint(uint256)": ("0xd2e684b8", 1),
}
SEL = {"mintReceipts": "0x93a8c438", "settleWindow": "0x1c9963fa", "cfg": "0x0457dad2",
       "certificate": "0x2dbf7b98", "totalSupply": "0x18160ddd", "oracle": "0x7dc0d1d0",
       "multiplier18": "0x05a3a104", "settler": "0xab221a76"}


def log(t):
    print(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()) + " " + t, flush=True)


def vaults():
    return {v["vault"].lower(): v for v in json.load(open(BOOK))["vaults"]}


# ---------------------------------------------------------------------------- intake (France's key)
def intake():
    """Validate one request from stdin, queue it, wait for serve's answer, print it. Runs as the
    intake user, which can write the inbox and read the outbox and nothing else."""
    raw = sys.stdin.buffer.read(4097)
    ans = lambda d: (print(json.dumps(d)), 0 if d.get("status") == 1 else 1)[1]
    if len(raw) > 4096:
        return ans({"status": 0, "reason": "request over 4 KiB"})
    try:
        req = json.loads(raw.decode())
    except Exception:                                            # noqa: BLE001
        return ans({"status": 0, "reason": "not JSON"})
    if req.get("action") == "whoami":
        return ans({"status": 1, "settler": os.environ.get("SETTLER_ADDR", "")})
    vault, sig, args = str(req.get("vault", "")).lower(), req.get("sig"), req.get("args")
    if vault not in vaults():
        return ans({"status": 0, "reason": "not a stack-5 vault"})
    if sig not in ACTIONS or not isinstance(args, list) or len(args) != ACTIONS[sig][1] \
            or not all(isinstance(a, str) and re.fullmatch(r"[0-9]{1,78}", a) for a in args):
        return ans({"status": 0, "reason": "action or arguments not allowed"})
    rid = time.strftime("%Y%m%dT%H%M%S") + "-" + secrets.token_hex(6)
    tmp = os.path.join(INBOX, rid + ".part")
    with open(tmp, "w") as f:
        json.dump({"vault": vault, "sig": sig, "args": args, "at": int(time.time())}, f)
    os.replace(tmp, os.path.join(INBOX, rid + ".json"))
    out = os.path.join(OUTBOX, rid + ".json")
    for _ in range(ANSWER_WAIT_SEC * 2):
        if os.path.exists(out):
            with open(out) as f:
                return ans(json.load(f))
        time.sleep(0.5)
    return ans({"status": 0, "reason": "no answer within %d s (queued as %s; check before asking again)" % (ANSWER_WAIT_SEC, rid)})


# ---------------------------------------------------------------------------- reads
def rpc(method, params):
    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode()
    for attempt in range(5):
        try:
            with urllib.request.urlopen(urllib.request.Request(RPC, body, UA), timeout=20) as r:
                out = json.load(r)
            break
        except urllib.error.HTTPError as e:
            if e.code not in (429, 502, 503, 504) or attempt == 4:
                raise
            time.sleep(2 * 2 ** attempt)
    if "error" in out:
        raise RuntimeError(out["error"])
    return out["result"]


def words(to, data):
    out = rpc("eth_call", [{"to": to, "data": data}, "latest"])[2:]
    return [int(out[i:i + 64], 16) for i in range(0, len(out), 64)]


def w32(n):
    return "%064x" % int(n)


def venue_position_units(vault, market, size_dec):
    """Signed position of `market` on the vault's venue account, in venue units (public read)."""
    req = urllib.request.Request(API + "/api/v1/account?by=l1_address&value=" + vault, headers={"User-Agent": UA["User-Agent"]})
    with urllib.request.urlopen(req, timeout=20) as r:
        d = json.load(r)
    for p in d["accounts"][0].get("positions", []):
        if int(p.get("market_id", -1)) == market:
            return int(p.get("sign", 1) or 1) * int(Decimal(p.get("position", "0")) * 10 ** size_dec)
    return 0


def required_units(certs18, mult18, size_dec):
    """Venue units needed to hedge `certs18` certificates of `mult18` shares each, floored as the vault does."""
    return certs18 * mult18 // 10**18 * 10**size_dec // 10**18


# ---------------------------------------------------------------------------- checks
def load_ledger():
    try:
        with open(LEDGER) as f:
            return json.load(f)
    except FileNotFoundError:
        return {"sends": [], "settled_usd": []}


def check(req, ledger, now=None):
    """None if the request may be sent, else the reason it is refused."""
    now = time.time() if now is None else now
    vault, sig, args = req["vault"], req["sig"], [int(a) for a in req["args"]]
    recent = [t for t in ledger["sends"] if now - t < 3600]
    if len(recent) >= MAX_SENDS_PER_HOUR:
        return "rate limit: %d sends in the last hour" % len(recent)
    if sig not in ("settleMint(uint256,uint256)", "rehedge(uint256)"):
        return None
    cfg = words(vault, SEL["cfg"])
    market, size_dec, band_bps = cfg[3], cfg[4], cfg[8]
    cert = "0x" + "%040x" % words(vault, SEL["certificate"])[0]
    oracle = "0x" + "%040x" % words(vault, SEL["oracle"])[0]
    supply = words(cert, SEL["totalSupply"])[0]
    mult = words(oracle, SEL["multiplier18"])[0]
    pos = venue_position_units(vault, market, size_dec)
    if sig == "rehedge(uint256)":
        gap = required_units(supply, mult, size_dec) - pos
        if args[0] > gap + POSITION_TOL_UNITS:
            return "rehedge(%d) but the public position is short by only %d units" % (args[0], gap)
        return None
    rid, fill = args
    r = words(vault, SEL["mintReceipts"] + w32(rid))
    user, escrow, settled, req_px, requested_at, staged, indicative = r[:7]
    if user == 0:
        return "receipt %d does not exist" % rid
    if settled or staged:
        return "receipt %d is %s" % (rid, "settled" if settled else "staged for refund")
    if now > requested_at + words(vault, SEL["settleWindow"])[0]:
        return "receipt %d is past its settle window" % rid
    if req_px == 0 or abs(fill - req_px) * 10_000 > req_px * band_bps:
        return "fill %d is outside the %d bps settle band of the request price %d" % (fill, band_bps, req_px)
    need = required_units(supply + indicative, mult, size_dec)
    if pos + POSITION_TOL_UNITS < need:
        return ("the venue position is %d units; certificates after this settle need %d "
                "(supply %d + receipt %d, multiplier %d): hedge first" % (pos, need, supply, indicative, mult))
    usd = Decimal(indicative) * Decimal(fill) / Decimal(10**36)
    day = sum(Decimal(x[1]) for x in ledger["settled_usd"] if now - x[0] < 86400)
    if day + usd > DAILY_SETTLE_USD:
        return "daily settle budget: %.2f USD today + %.2f > %s" % (day, usd, DAILY_SETTLE_USD)
    return None


# ---------------------------------------------------------------------------- serve (the key)
def serve(once=False):
    from eth_account import Account
    acct = Account.from_key(os.environ["SETTLER_PK"])
    for v in vaults().values():
        on = "0x" + "%040x" % words(v["vault"], SEL["settler"])[0]
        if on.lower() != acct.address.lower():
            log("WARN  %s settler() is %s, not this key %s: its requests will revert" % (v["symbol"], on, acct.address))
    log("settler %s serving %s" % (acct.address, INBOX))
    while True:
        for name in sorted(os.listdir(INBOX)):
            if not name.endswith(".json"):
                continue
            path = os.path.join(INBOX, name)
            with open(path) as f:
                req = json.load(f)
            os.remove(path)
            ledger = load_ledger()
            try:
                why = check(req, ledger)
                if why:
                    ans = {"status": 0, "reason": why}
                else:
                    ans = send(acct, req)
                    ledger["sends"].append(time.time())
                    if ans["status"] == 1 and req["sig"].startswith("settleMint"):
                        r = words(req["vault"], SEL["mintReceipts"] + w32(req["args"][0]))
                        ledger["settled_usd"].append([time.time(), str(Decimal(r[6]) * Decimal(int(req["args"][1])) / Decimal(10**36))])
            except Exception as e:                               # noqa: BLE001
                ans = {"status": 0, "reason": "error: %s" % str(e)[:200]}
            ledger["sends"] = [t for t in ledger["sends"] if time.time() - t < 7200]
            ledger["settled_usd"] = [x for x in ledger["settled_usd"] if time.time() - x[0] < 172800]
            tmp = LEDGER + ".tmp"
            with open(tmp, "w") as f:
                json.dump(ledger, f)
            os.replace(tmp, LEDGER)
            out = os.path.join(OUTBOX, name)
            with open(out + ".part", "w") as f:
                json.dump(ans, f)
            os.chmod(out + ".part", 0o640)
            os.replace(out + ".part", out)
            log("%s %s %s(%s) -> %s" % (name[:-5], req["vault"][:10], req["sig"].split("(")[0], ",".join(req["args"]),
                                       ("OK " + ans.get("tx", "")) if ans["status"] == 1 else "REFUSED " + ans["reason"]))
        for name in os.listdir(OUTBOX):                           # answers nobody collected
            p = os.path.join(OUTBOX, name)
            if time.time() - os.path.getmtime(p) > 3600:
                os.remove(p)
        if once:
            return
        time.sleep(1)


def send(acct, req):
    sel, _ = ACTIONS[req["sig"]]
    data = sel + "".join(w32(a) for a in req["args"])
    frm = acct.address
    try:
        rpc("eth_call", [{"from": frm, "to": req["vault"], "data": data}, "latest"])
    except RuntimeError as e:
        err = e.args[0] if e.args else {}
        return {"status": 0, "reason": "would revert: %s" % str(err.get("data") or err.get("message") if isinstance(err, dict) else err)[:160]}
    gas = int(rpc("eth_estimateGas", [{"from": frm, "to": req["vault"], "data": data}]), 16)
    tx = {"chainId": CHAIN_ID, "nonce": int(rpc("eth_getTransactionCount", [frm, "pending"]), 16), "to": req["vault"],
          "value": 0, "data": data, "type": 2, "gas": gas * 13 // 10,
          "maxFeePerGas": int(rpc("eth_gasPrice", []), 16) * 2, "maxPriorityFeePerGas": 0}
    raw = acct.sign_transaction(tx).raw_transaction
    h = rpc("eth_sendRawTransaction", ["0x" + raw.hex().removeprefix("0x")])
    for _ in range(60):
        r = rpc("eth_getTransactionReceipt", [h])
        if r:
            return {"status": 1 if r.get("status") == "0x1" else 0, "tx": h,
                    **({} if r.get("status") == "0x1" else {"reason": "reverted on chain"})}
        time.sleep(2)
    return {"status": 0, "tx": h, "reason": "no receipt after 120 s: check the chain before asking again"}


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "intake":
        return intake()
    if cmd == "serve":
        return serve("--once" in sys.argv)
    if cmd == "check":
        req = {"vault": sys.argv[2].lower(), "sig": sys.argv[3], "args": sys.argv[4:]}
        why = check(req, load_ledger())
        print("OK: would send" if why is None else "REFUSED: " + why)
        return 0 if why is None else 1
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main())
