class Refuse(Exception):
    """The kit will not go on: the state is not what this step assumes. Exit status 2."""


def say(*a):
    print(*a, flush=True)


def ok(msg):
    say("   ok    " + msg)


def step(msg):
    say("\n== " + msg)


def utc(ts):
    return datetime.datetime.fromtimestamp(int(ts), datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")


# ------------------------------------------------------------------------- keccak (pure Python)
#
# The same Keccak-256 as deploy/tests/_ethstub.py (Ethereum's pre-NIST padding). Used to cross-check
# the Safe's own getTransactionHash and to compute proposal ids; never trusted alone.

_RC = [0x0000000000000001, 0x0000000000008082, 0x800000000000808A, 0x8000000080008000,
       0x000000000000808B, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
       0x000000000000008A, 0x0000000000000088, 0x0000000080008009, 0x000000008000000A,
       0x000000008000808B, 0x800000000000008B, 0x8000000000008089, 0x8000000000008003,
       0x8000000000008002, 0x8000000000000080, 0x000000000000800A, 0x800000008000000A,
       0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008]
_ROT = [[0, 36, 3, 41, 18], [1, 44, 10, 45, 2], [62, 6, 43, 15, 61], [28, 55, 25, 21, 56], [27, 20, 39, 8, 14]]
_M64 = (1 << 64) - 1


def _rol(v, n):
    return ((v << n) | (v >> (64 - n))) & _M64 if n else v


def _keccak_f(a):
    for rc in _RC:
        c = [a[x][0] ^ a[x][1] ^ a[x][2] ^ a[x][3] ^ a[x][4] for x in range(5)]
        d = [c[(x - 1) % 5] ^ _rol(c[(x + 1) % 5], 1) for x in range(5)]
        a = [[a[x][y] ^ d[x] for y in range(5)] for x in range(5)]
        b = [[0] * 5 for _ in range(5)]
        for x in range(5):
            for y in range(5):
                b[y][(2 * x + 3 * y) % 5] = _rol(a[x][y], _ROT[x][y])
        a = [[b[x][y] ^ (~b[(x + 1) % 5][y] & b[(x + 2) % 5][y]) for y in range(5)] for x in range(5)]
        a[0][0] ^= rc
    return a


def keccak256(data):
    rate = 136
    msg = bytearray(data) + b"\x01"
    msg += b"\x00" * (-len(msg) % rate)
    msg[-1] |= 0x80
    a = [[0] * 5 for _ in range(5)]
    for off in range(0, len(msg), rate):
        block = msg[off:off + rate]
        for i in range(rate // 8):
            a[i % 5][i // 5] ^= int.from_bytes(block[8 * i:8 * i + 8], "little")
        a = _keccak_f(a)
    return b"".join(a[i % 5][i // 5].to_bytes(8, "little") for i in range(4))


# ------------------------------------------------------------------------------------ ABI

def hb(x):
    """hex string (with or without 0x) -> bytes."""
    x = x.strip()
    x = x[2:] if x[:2] in ("0x", "0X") else x
    if len(x) % 2 or not re.fullmatch(r"[0-9a-fA-F]*", x):
        raise ValueError("not hex: %r" % x[:40])
    return bytes.fromhex(x)


def hx(b):
    return "0x" + bytes(b).hex()


def is_addr(a):
    return isinstance(a, str) and re.fullmatch(r"0x[0-9a-fA-F]{40}", a) is not None


def addr_eq(a, b):
    return is_addr(a) and is_addr(b) and a.lower() == b.lower()


def _pad32(b):
    return b + b"\x00" * (-len(b) % 32)


def _static(t, v):
    if t == "address":
        if not is_addr(v):
            raise ValueError("not an address: %r" % (v,))
        return bytes(12) + hb(v)
    if t == "bytes32":
        b = hb(v) if isinstance(v, str) else bytes(v)
        if len(b) != 32:
            raise ValueError("bytes32 of length %d" % len(b))
        return b
    if t == "bool":
        return int(bool(v)).to_bytes(32, "big")
    if t.startswith("uint"):
        bits = int(t[4:] or 256)
        v = int(v)
        if not 0 <= v < 1 << bits:
            raise ValueError("%s out of range: %d" % (t, v))
        return v.to_bytes(32, "big")
    raise ValueError("unsupported ABI type " + t)


def abi_encode(types, values):
    head, tail = [], b""
    base = 32 * len(types)
    for t, v in zip(types, values):
        if t == "bytes":
            b = hb(v) if isinstance(v, str) else bytes(v)
            head.append((base + len(tail)).to_bytes(32, "big"))
            tail += len(b).to_bytes(32, "big") + _pad32(b)
        else:
            head.append(_static(t, v))
    return b"".join(head) + tail


def calldata(name, types=(), values=()):
    return hb(SEL[name]) + abi_encode(list(types), list(values))


def word(data, i):
    return int.from_bytes(data[32 * i:32 * i + 32], "big")


def w_addr(data, i=0):
    return "0x" + data[32 * i + 12:32 * i + 32].hex()


def dec_bytes_at(data, i):
    """A dynamic `bytes` whose head word is argument i."""
    off = word(data, i)
    n = int.from_bytes(data[off:off + 32], "big")
    return data[off + 32:off + 32 + n]


def dec_address_array(data):
    off = word(data, 0)
    n = int.from_bytes(data[off:off + 32], "big")
    return ["0x" + data[off + 32 + 32 * k + 12:off + 64 + 32 * k].hex() for k in range(n)]


def dec_string(data):
    return dec_bytes_at(data, 0).decode()


def checksum(a):
    """EIP-55."""
    a = a.lower()[2:]
    h = keccak256(a.encode()).hex()
    return "0x" + "".join(c.upper() if c.isalpha() and int(h[i], 16) >= 8 else c for i, c in enumerate(a))


def fmt18(v):
    return "{:,.2f}".format(Decimal(v) / Decimal(10) ** 18)


# ------------------------------------------------------------------------------ MultiSend

def multisend_entries(data_hex):
    """multiSend(bytes) calldata -> [(operation, to, value, data bytes)]. Refuses anything else."""
    d = hb(data_hex)
    if d[:4].hex() != SEL["multiSend"]:
        raise Refuse("batch data is not a multiSend(bytes) call (selector 0x%s)" % d[:4].hex())
    body = d[4:]
    if word(body, 0) != 32:
        raise Refuse("multiSend data has an unexpected offset")
    n = word(body, 1)
    packed = body[64:64 + n]
    if len(packed) != n or any(body[64 + n:]) or len(body) != 64 + len(_pad32(packed)):
        raise Refuse("multiSend data is truncated or padded with non-zero bytes")
    out, i = [], 0
    while i < n:
        if i + 85 > n:
            raise Refuse("multiSend entry header truncated at byte %d" % i)
        op = packed[i]
        to = "0x" + packed[i + 1:i + 21].hex()
        value = int.from_bytes(packed[i + 21:i + 53], "big")
        ln = int.from_bytes(packed[i + 53:i + 85], "big")
        cd = packed[i + 85:i + 85 + ln]
        if len(cd) != ln:
            raise Refuse("multiSend entry data truncated at byte %d" % i)
        out.append((op, to, value, bytes(cd)))
        i += 85 + ln
    return out


def multisend_encode(entries):
    packed = b"".join(bytes([op]) + hb(to) + int(v).to_bytes(32, "big") + len(cd).to_bytes(32, "big") + cd
                      for op, to, v, cd in entries)
    return hx(hb(SEL["multiSend"]) + (32).to_bytes(32, "big") + len(packed).to_bytes(32, "big") + _pad32(packed))


def split_multisend(data_hex, limit=MAX_BATCH_HEX):
    """Split one multiSend batch into as few consecutive batches as keep each one's hex at or
    under `limit` characters. Call order is kept; every call lands in exactly one part, once."""
    entries = multisend_entries(data_hex)
    if len(data_hex) <= limit:
        return [data_hex]
    parts, cur = [], []
    for e in entries:
        alone = len(multisend_encode([e]))
        if alone > limit:
            raise Refuse("one call alone is %d hex characters, above %d; it cannot be sent" % (alone, limit))
        if cur and len(multisend_encode(cur + [e])) > limit:
            parts.append(multisend_encode(cur))
            cur = []
        cur.append(e)
    if cur:
        parts.append(multisend_encode(cur))
    return parts


def describe_call(to, cd, labels):
    """One line per call, for the signing page and the log."""
    name = NAME_OF_SEL.get(cd[:4].hex(), "0x" + cd[:4].hex())
    who = labels.get(to.lower(), to)
    body = cd[4:]
    lab = lambda a: labels.get(a.lower(), a)                          # noqa: E731
    try:
        if name in ("registerVault", "setFeeSink", "setInsurancePool", "setSettler"):
            arg = lab(w_addr(body, 0))
        elif name == "setAbsoluteCap":
            arg = "%s, %s USD" % (lab(w_addr(body, 0)), fmt18(word(body, 1)))
        elif name == "setVenueMinimums":
            arg = "base %d, notional %s USD" % (word(body, 0), fmt18(word(body, 1)))
        elif name == "setVenueApiKey":
            arg = "index %d, key %s" % (word(body, 0), hx(dec_bytes_at(body, 1)))
        elif name == "setBufferThresholds":
            arg = ", ".join(fmt18(word(body, k)) for k in range(4))
        elif name == "proposeChange":
            inner = describe_call(to, dec_bytes_at(body, 0), labels).split(": ", 1)[1]
            return "%s: proposeChange(%s)" % (who, inner)
        else:
            arg = ""
    except Exception:                                              # noqa: BLE001
        arg = "?"
    return "%s: %s(%s)" % (who, name, arg)


# ----------------------------------------------------------------------------- Safe EIP-712

def safe_tx_hash(safe, to, data_hex, operation, nonce, chain_id=CHAIN_ID):
    """EIP-712 SafeTx hash as Safe 1.3.0 / 1.4.1 computes it (value, gas fields, gas token and
    refund receiver all zero). A cross-check only: the hash the kit trusts is getTransactionHash."""
    dom = keccak256(abi_encode(["bytes32", "uint256", "address"], [hb(DOMAIN_TYPEHASH), chain_id, safe]))
    st = keccak256(abi_encode(
        ["bytes32", "address", "uint256", "bytes32", "uint8", "uint256", "uint256", "uint256", "address", "address",
         "uint256"],
        [hb(SAFE_TX_TYPEHASH), to, 0, keccak256(hb(data_hex)), operation, 0, 0, 0, ZERO, ZERO, nonce]))
    return hx(keccak256(b"\x19\x01" + dom + st))


SIG_LINE = re.compile(r"^\s*(?P<label>\S+)\s+nonce\s+(?P<nonce>\d+)\s+owner\s+(?P<owner>0x[0-9a-fA-F]{40})"
                      r"\s+signature\s+(?P<sig>0x[0-9a-fA-F]{130})\s*$")


def parse_signatures(text, label, nonce):
    """The lines the signing page's copy box produces, for this batch and nonce only.
    Returns (entries [(owner, sig)], number of lines for other batches)."""
    out, others = [], 0
    for line in text.splitlines():
        m = SIG_LINE.match(line)
        if not m:
            continue
        if m["label"] != label or int(m["nonce"]) != int(nonce):
            others += 1
            continue
        out.append((m["owner"], m["sig"]))
    return out, others


def normalize_sig(sig_hex):
    """65 bytes r|s|v with v 27 or 28 (a wallet returning 0/1 is lifted). Anything else - an
    eth_sign (v > 30) or a contract signature - is refused: the page only makes typed-data ones."""
    b = bytearray(hb(sig_hex))
    if len(b) != 65:
        raise Refuse("signature is %d bytes, not 65" % len(b))
    if b[64] in (0, 1):
        b[64] += 27
    if b[64] not in (27, 28):
        raise Refuse("signature v=%d is not an EIP-712 ECDSA signature" % b[64])
    return bytes(b)


def order_signatures(entries, owners, threshold):
    """entries: [(claimed owner, signature hex, recovered address)]. Returns (signatures bytes,
    owners in order). Safe.checkNSignatures requires strictly ascending signers, so they are
    sorted by owner address as a number. A signature that does not recover to its claimed owner,
    a non-owner, two different signatures from one owner, or fewer than `threshold` owners is
    refused."""
    owners_l = {o.lower() for o in owners}
    seen = {}
    for claimed, sig, rec in entries:
        if not addr_eq(claimed, rec):
            raise Refuse("a signature claimed for %s recovers to %s" % (claimed, rec))
        if claimed.lower() not in owners_l:
            raise Refuse("%s signed, but is not an owner of the Safe" % claimed)
        s = normalize_sig(sig)
        if claimed.lower() in seen and seen[claimed.lower()] != s:
            raise Refuse("two different signatures from %s" % claimed)
        seen[claimed.lower()] = s
    if len(seen) < threshold:
        raise Refuse("%d distinct owner signature(s); the Safe needs %d" % (len(seen), threshold))
    order = sorted(seen, key=lambda a: int(a, 16))
    return b"".join(seen[a] for a in order), order


def exec_calldata(to, data_hex, operation, sigs):
    return hx(calldata("execTransaction",
                       ["address", "uint256", "bytes", "uint8", "uint256", "uint256", "uint256", "address", "address",
                        "bytes"],
                       [to, 0, hb(data_hex), operation, 0, 0, 0, ZERO, ZERO, sigs]))


# ------------------------------------------------------------------------------ the venue

def venue_minimums(detail, market_id, size_decimals):
    """(MINBASE, MINQUOTE) as usecert-keeper-setup computes them - round(min_base_amount x
    10^size_decimals) and min_quote_amount x 1e18 - in exact decimal arithmetic. Refuses a row for
    another market, in other units, not active, or finer than the units it converts to."""
    if int(detail.get("market_id", -1)) != int(market_id):
        raise Refuse("venue answered market %s for market %s" % (detail.get("market_id"), market_id))
    sd = int(detail.get("size_decimals", detail.get("supported_size_decimals", -1)))
    if sd != int(size_decimals):
        raise Refuse("market %s: venue size_decimals %d, book sizeDecimals %d" % (market_id, sd, size_decimals))
    if str(detail.get("status", "active")) != "active":
        raise Refuse("market %s is %s on the venue" % (market_id, detail.get("status")))
    base = Decimal(str(detail["min_base_amount"])) * (Decimal(10) ** sd)
    quote = Decimal(str(detail["min_quote_amount"])) * (Decimal(10) ** 18)
    if base != base.to_integral_value() or quote != quote.to_integral_value():
        raise Refuse("market %s: minimums %s / %s are finer than the units they convert to"
                     % (market_id, detail["min_base_amount"], detail["min_quote_amount"]))
    base, quote = int(base), int(quote)
    if base <= 0 or quote <= 0:
        raise Refuse("market %s: zero venue minimum" % market_id)
    if quote > 1000 * 10 ** 18:
        raise Refuse("market %s: min notional above CertVault's $1,000 bound" % market_id)
    return base, quote


def parse_pubkeys(text):
    """pubkeys.env -> (api_key_index, {sym: 0x...80 hex}, dry_run_marker)."""
    idx, keys, dry = None, {}, False
    for line in text.splitlines():
        line = line.strip()
        if line == DRY_RUN_MARKER:
            dry = True
        if not line or line.startswith("#"):
            continue
        k, _, v = line.partition("=")
        if k == "API_KEY_INDEX":
            idx = int(v)
        elif k.startswith("PUBKEY_"):
            if not re.fullmatch(r"0x[0-9a-fA-F]{80}", v):
                raise Refuse("%s is not a 40-byte hex key" % k)
            keys[k[len("PUBKEY_"):]] = v.lower()
        else:
            raise Refuse("unexpected line in pubkeys.env: %r" % k)
    if idx is None or not 2 <= idx <= 254:
        raise Refuse("pubkeys.env has no valid API_KEY_INDEX")
    return idx, keys, dry


def pubkeys_env(idx, keys, dry=False):
    out = [DRY_RUN_MARKER] if dry else []
    out.append("# public halves of the stack-5 venue API keys; the private halves stay in %s on France" % F_KEYS)
    out.append("API_KEY_INDEX=%d" % idx)
    out += ["PUBKEY_%s=%s" % (s, keys[s]) for s in keys]
    return "\n".join(out) + "\n"


# ------------------------------------------------------------------------------- the book

def load_book(path, safe=GOVERNANCE_SAFE, settler=STACK5_SETTLER, sim=False):
    """The stack-5 book as DeployMainnet._writeAddressBook writes it, checked against the asset
    table and the live governance facts. `sim`: accept the book's own Safe and settler (offline
    runs against a test book)."""
    try:
        with open(path, "rb") as f:
            raw = f.read()
        book = json.loads(raw)
    except (OSError, ValueError) as e:
        raise Refuse("cannot read the stack-5 book %s: %s" % (path, e))
    if book.get("stack") != 5:
        raise Refuse("%s is not a stack-5 book (\"stack\": %r)" % (path, book.get("stack")))
    if book.get("chainId") != CHAIN_ID:
        raise Refuse("%s is for chain %r, not %d" % (path, book.get("chainId"), CHAIN_ID))
    gov = book.get("senders", {}).get("governance")
    if not sim and not addr_eq(gov, safe):
        raise Refuse("the book's governance is %s, not the Safe %s" % (gov, safe))
    sh = book.get("shared", {})
    for k in ("certFactory", "capacityOracle", "feeVault", "insuranceStaking", "settler", "solvencyRegistry"):
        if not is_addr(sh.get(k)) or int(sh[k], 16) == 0:
            raise Refuse("the book has no shared.%s" % k)
    if not sim and not addr_eq(sh["settler"], settler):
        raise Refuse("the book's settler is %s, the stack-5 settler key is %s" % (sh["settler"], settler))
    vaults = book.get("vaults") or []
    table = [a for a in ASSETS if a[0] in {v.get("symbol") for v in vaults}]
    if not vaults or [v.get("symbol") for v in vaults] != [a[0] for a in table]:
        raise Refuse("the book's vaults %s are not the asset table's, in its order" % [v.get("symbol") for v in vaults])
    for v, (sym, mkt) in zip(vaults, table):
        if int(v.get("marketIndex", -1)) != mkt:
            raise Refuse("%s: book market %s, asset table %d" % (sym, v.get("marketIndex"), mkt))
        for k in ("vault", "certificate", "certOracle", "bufferBook"):
            if not is_addr(v.get(k)) or int(v[k], 16) == 0:
                raise Refuse("%s has no %s in the book" % (sym, k))
    if not isinstance(book.get("blockNumber"), int) or book["blockNumber"] <= 0:
        raise Refuse("the book records no blockNumber")
    book["_path"] = path
    book["_sha256"] = hashlib.sha256(raw).hexdigest()
    book["_safe"] = gov if sim else safe
    return book


def labels_of(book):
    lab = {book["_safe"].lower(): "Safe"}
    for k, v in book["shared"].items():
        if is_addr(v):
            lab.setdefault(v.lower(), k)
    for v in book["vaults"]:
        lab[v["vault"].lower()] = v["symbol"] + " vault"
        lab[v["certificate"].lower()] = v["symbol"] + " certificate"
    return lab


# ---------------------------------------------------------------------- keeper configuration

def keeper_config(book, v, template, start_block, funding_start_ts):
    """/opt/keeper/vaults/s5-<sym>.json. Transport settings (rpc, api, cast, fill timeout, auto
    recall) come from the running stack-4 config on the same host; everything about the vault
    comes from the stack-5 book."""
    for k in ("rpc", "api", "cast"):
        if not template.get(k):
            raise Refuse("the stack-4 template config has no %r" % k)
    if template["api"].rstrip("/") != VENUE_API:
        raise Refuse("the template's venue API is %s, not %s (the USDC exchange is another venue)"
                     % (template["api"], VENUE_API))
    sym = v["symbol"]
    return {
        "_generatedBy": "deploy/bin/usecert-s5-cutover keeper-configs, from %s (sha256 %s)"
                        % (os.path.basename(book["_path"]), book["_sha256"][:12]),
        "symbol": sym,
        "stack": 5,
        "vault": v["vault"],
        "oracle": v["certOracle"],
        "market_index": int(v["marketIndex"]),
        "price_decimals": int(v["priceDecimals"]),
        "size_decimals": int(v["sizeDecimals"]),
        "rpc": template["rpc"],
        "api": template["api"],
        "cast": template["cast"],
        "fill_timeout_sec": int(template.get("fill_timeout_sec", 180)),
        "auto_recall": bool(template.get("auto_recall", False)),
        "start_block": int(start_block),
        "funding_start_ts": int(funding_start_ts),
        "state_file": "%s/state-s5-%s.json" % (F_KEEPER, sym),
        "api_key_file": "%s/s5-%s-key.json" % (F_KEYS, sym),
        "settler_key_file": F_SETTLER_KEY,
        "auto_rehedge": False,
    }


def find_deploy_block(has_code, lo, hi):
    """Smallest block in (lo, hi] at which has_code(block) is true, given has_code(lo) false and
    has_code(hi) true. Binary search: about 27 reads for 1e8 blocks."""
    if has_code(lo):
        raise Refuse("the vault already has code at the book's block %d: not the book it was deployed with" % lo)
    if not has_code(hi):
        raise Refuse("the vault has no code at block %d" % hi)
    while hi - lo > 1:
        mid = (lo + hi) // 2
        if has_code(mid):
            hi = mid
        else:
            lo = mid
    return hi


# ------------------------------------------------------------------------- the signer check

def check_attestations(resp, want_oracles, mark_version):
    """Problems with a signer bundle (the /attestations body, or the signer's --once output),
    for a signer that must sign exactly `want_oracles` with marks of `mark_version` (2: stack 5;
    1: the stack-4 format, which carries no markSigVersion). Empty list = good."""
    probs = []
    if resp.get("stale"):
        probs.append("bundle is stale")
    if resp.get("error"):
        probs.append("signer error: %s" % str(resp["error"])[:160])
    if resp.get("refused"):
        probs.append("refused: %s" % "; ".join("%s %s" % (r.get("symbol"), r.get("reason"))
                                             for r in resp["refused"])[:300])
    atts = resp.get("attestations") or []
    got = {str(a.get("certOracle", "")).lower(): a for a in atts}
    want = {o.lower() for o in want_oracles}
    for o in sorted(want - set(got)):
        probs.append("no mark for oracle %s" % o)
    for o in sorted(set(got) - want):
        probs.append("a mark for an oracle not in the book: %s" % o)
    for o in sorted(want & set(got)):
        a = got[o]
        name = a.get("symbol", o)
        ver = int(a.get("markSigVersion", 1))
        if ver != mark_version:
            probs.append("%s: markSigVersion %s, want %d" % (name, a.get("markSigVersion", "absent (v1)"), mark_version))
        if mark_version == 2 and (not a.get("markObservedAt")
                                  or int(a.get("markDeadline", 0)) - int(a["markObservedAt"]) > 60):
            probs.append("%s: v2 mark without observedAt, or with a deadline past 60 s" % name)
        if not str(a.get("markSig", "")).startswith("0x") or not str(a.get("attestSig", "")).startswith("0x"):
            probs.append("%s: unsigned" % name)
    return probs


