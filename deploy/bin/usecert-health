#!/usr/bin/env bash
# Chain-specific health. Everything else - disk, RAM, services, containers, network -
# is Netdata's job. This covers only what nothing off-the-shelf can understand.
#
# WHAT "HEALTHY" MEANS CHANGED ON 2026-09-20, and the old checks became noise.
#
# The attester used to broadcast on a timer, so a stale attestation meant the keeper
# was broken and minting was dead. It now SIGNS, and whoever mints RELAYS the
# signature inside their own transaction. Between mints the attestation is stale and
# capacity reads zero BY DESIGN - that is an idle protocol costing nothing, not a
# fault. Alerting on it fired six times every fifteen minutes and described correct
# behaviour, which is the fastest way to make an operator stop reading alerts.
#
# So what actually breaks minting now is the SIGNER: if it stops producing valid,
# in-date signatures, nobody can open capacity and no mint can succeed. That is the
# thing this file watches.
set -uo pipefail
source /etc/usecert/telegram.env 2>/dev/null || true
TG_TOKEN="${TG_TOKEN:-}"; TG_CHAT="${TG_CHAT:-}"
SUMMARY="${1:-}"
BOOK=/opt/usecert/deployments/46630.json
RPC=https://rpc.testnet.chain.robinhood.com
SIGNER=http://127.0.0.1:8787/attestations
export PATH="/home/usecert/.foundry/bin:$PATH"
HOST=$(hostname)
P=(); AGES=""

notify() {
  if [ -z "$TG_TOKEN" ] || [ -z "$TG_CHAT" ]; then echo "$1"; return; fi
  curl -s -m 20 -X POST "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
    -d chat_id="${TG_CHAT}" -d parse_mode=HTML --data-urlencode text="$1" >/dev/null
}

# Which mode is the keeper in? The right alarms differ, so read it rather than assume.
ON_DEMAND=$(systemctl show usecert-keeper -p Environment --value 2>/dev/null | tr ' ' '\n' | grep -oP 'ATTEST_ON_DEMAND=\K.*' || echo 0)

# ---------------------------------------------------------------- the signer
if [ "$ON_DEMAND" = "1" ]; then
  if ! systemctl is-active --quiet usecert-signer; then
    P+=("<b>signer is down</b> - no signatures, so nobody can open capacity and every mint reverts")
  else
    BODY=$(curl -s -m 15 "$SIGNER" 2>/dev/null)
    if [ -z "$BODY" ]; then
      P+=("<b>signer not answering</b> on 8787 - minting cannot be opened")
    else
      STALE=$(printf '%s' "$BODY" | grep -oP '"stale":\s*\K(true|false)')
      SERR=$(printf '%s' "$BODY" | grep -oP '"error":\s*"\K[^"]*')
      NMIR=$(printf '%s' "$BODY" | grep -o '"symbol"' | wc -l)
      [ "$STALE" = "true" ] && P+=("<b>signer batch is stale</b> - its signatures are past their 60s deadline and will be refused")
      [ -n "$SERR" ] && P+=("signer error: $SERR")
      [ "${NMIR:-0}" -lt 1 ] && P+=("<b>signer produced no signatures</b>")
    fi
  fi
  # The public route is how a browser reaches it; loopback working is not enough.
  PUB=$(curl -s -o /dev/null -w '%{http_code}' -m 15 https://use-cert.com/api/attestations 2>/dev/null)
  [ "$PUB" != "200" ] && P+=("/api/attestations returns $PUB - the front end cannot fetch a signature")
fi

# ---------------------------------------------------------------- the chain
if [ ! -r "$BOOK" ]; then
  P+=("address book missing at $BOOK")
else
  REG=$(python3 -c "import json;print(json.load(open('$BOOK'))['shared']['solvencyRegistry'])" 2>/dev/null)
  CAP=$(python3 -c "import json;print(json.load(open('$BOOK'))['shared']['capacityOracle'])" 2>/dev/null)
  while read -r SYM V O; do
    [ -z "$V" ] && continue
    A=$(timeout 20 cast call "$REG" 'ageSec(address)(uint256)' "$V" --rpc-url "$RPC" </dev/null 2>/dev/null | awk '{print $1}')
    if [ -z "$A" ]; then P+=("$SYM: attestation age unreadable (RPC down?)"); continue; fi
    AGES="$AGES%0A  $SYM ${A}s"
    # In on-demand mode age is NOT an alarm - it is the idle state. It only matters
    # when the keeper is supposed to be holding the attestation fresh itself.
    if [ "$ON_DEMAND" != "1" ] && [ "$A" -ge 240 ]; then
      P+=("<b>$SYM attestation ${A}s</b> of 300s - minting halts at 300")
    fi
    MA=$(timeout 20 cast call "$O" 'mintAllowed()(bool)' --rpc-url "$RPC" </dev/null 2>/dev/null)
    # mintAllowed is the ORACLE gate and is independent of attestation age. False here
    # means the price feed itself is unhealthy, which no relay can fix.
    #
    # Say WHICH guard failed. mintAllowed() folds three of them - feed staleness, deviation
    # and basis - into one boolean, and on 2026-09-23 that boolean cost about twenty minutes
    # of digging to learn it meant "the uNVDA feed is 1091s old against a 900s limit". The
    # feed age is one call away and is almost always the answer, so the alert carries it.
    if [ "$MA" = "false" ]; then
      FA=""
      AGG=$(python3 -c "import json;d=json.load(open('$BOOK'));print(next((v['replayAggregator'] for v in d['vaults'] if v['symbol']=='$SYM'),''))" 2>/dev/null)
      if [ -n "$AGG" ]; then
        UP=$(timeout 20 cast call "$AGG" 'latestRoundData()(uint80,int256,uint256,uint256,uint80)' --rpc-url "$RPC" </dev/null 2>/dev/null | sed -n '4p' | sed 's/ .*//')
        NOWB=$(timeout 20 cast block latest --field timestamp --rpc-url "$RPC" </dev/null 2>/dev/null | sed 's/ .*//')
        if [ -n "$UP" ] && [ -n "$NOWB" ]; then
          AGE_F=$(( NOWB - UP ))
          if [ "$AGE_F" -ge "${STALENESS_SECONDS:-900}" ]; then
            FA=" - the price feed is ${AGE_F}s old, past the ${STALENESS_SECONDS:-900}s limit, so px() reverts CertOracle_StalePrice. The FEED keeper is behind, not the attester."
          else
            FA=" - the price feed is fresh (${AGE_F}s), so this is the deviation or basis guard, not staleness."
          fi
        fi
      fi
      P+=("<b>$SYM mintAllowed() is false</b> - the oracle is unhealthy; a relay cannot fix this${FA}")
    fi
  done < <(python3 -c "
import json;d=json.load(open('$BOOK'))
[print(v['symbol'], v['vault'], v['certOracle']) for v in d['vaults']]" 2>/dev/null)
fi

# ---------------------------------------------------------------- keepers
systemctl is-active --quiet usecert-keeper || P+=("<b>usecert-keeper is not running</b> - batches stop settling and mints cannot hedge")

# ---------------------------------------------------------------- gas
# Rates MEASURED on 2026-09-20 after the cutover, not assumed: the attester spends
# nothing in on-demand mode, and the batch keeper carries the whole cost.
BATCH_WEI_PER_DAY=233000000000000   # 0.000233 ETH/day, batch advancer + feed keeper
ATTEST_WEI_PER_DAY=28359463818165120 # what the attester WOULD burn if put back in charge

chk() { # name addr wei_per_day
  local n=$1 a=$2 rate=$3
  local bal; bal=$(timeout 20 cast balance "$a" --rpc-url "$RPC" </dev/null 2>/dev/null)
  [ -z "$bal" ] && { P+=("$n balance unreadable (RPC down?)"); return; }
  [ "$rate" -eq 0 ] && return
  local days; days=$(python3 -c "print(f'{int('$bal')/$rate:.1f}')" 2>/dev/null)
  local eth;  eth=$(python3 -c "print(f'{int('$bal')/1e18:.6f}')" 2>/dev/null)
  if python3 -c "import sys;sys.exit(0 if int('$bal') < $rate*2 else 1)" 2>/dev/null; then
    P+=("<b>$n gas ${eth} ETH - ${days} days left</b>")
  elif python3 -c "import sys;sys.exit(0 if int('$bal') < $rate*7 else 1)" 2>/dev/null; then
    P+=("$n gas ${eth} ETH - ${days} days left, top up")
  fi
}
chk "batch-keeper" 0x066124926a69259590E64147371c6330FD287B8B "$BATCH_WEI_PER_DAY"
# The attester only spends if on-demand is switched off, so only judge it by that rate then.
[ "$ON_DEMAND" = "1" ] && ATTEST_RATE=0 || ATTEST_RATE=$ATTEST_WEI_PER_DAY
chk "attester" 0x33CCBBe41BB2374C7704B7eDA3743CC513C0002d "$ATTEST_RATE"

# ---------------------------------------------------------------- report
if [ ${#P[@]} -gt 0 ]; then
  MSG="⛓️ <b>$HOST</b> chain health%0A%0A"
  for p in "${P[@]}"; do MSG="$MSG• $p%0A"; done
  notify "$(printf '%b' "$MSG")"
elif [ "$SUMMARY" = "--summary" ]; then
  MODE=$([ "$ON_DEMAND" = "1" ] && echo "on-demand (attester signs, minters relay)" || echo "keeper broadcasts")
  notify "$(printf '%b' "✅ <b>$HOST</b> weekly chain summary%0A%0Amode: $MODE%0Aattestation ages:$AGES%0Asigner healthy, keeper running")"
fi
