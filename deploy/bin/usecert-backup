#!/usr/bin/env bash
# Nightly logical backup of every database on this host.
#
# This sits ALONGSIDE OVH's image backup, it does not replace it. The image gives
# whole-machine disaster recovery; this gives per-database, per-table recovery
# without rolling the entire box back a day. The incident that motivates it is
# real: a DROP SCHEMA CASCADE on one schema, with mail, keepers and deployments
# on the same machine perfectly healthy.
set -uo pipefail

# The Drive remote is authorised under the `usecert` account; these scripts run as
# root, and rclone reads the invoking user's config. Point it at the right file
# rather than duplicating the credential into root's home.
export RCLONE_CONFIG=/home/usecert/.config/rclone/rclone.conf

STAMP=$(date -u +%Y-%m-%dT%H%M%SZ)
DAY=$(date -u +%Y-%m-%d)
DEST=/var/backups/pg/$DAY
KEEP_LOCAL_DAYS=7
REMOTE=$(cat /etc/usecert/backup-remote 2>/dev/null || true)   # e.g. gdrive-crypt:usecert-backups
LOG=$(mktemp)
ERRORS=()
WARNINGS=()

source /etc/usecert/telegram.env 2>/dev/null || true

note(){ echo "[$(date -u +%H:%M:%S)] $*" | tee -a "$LOG"; }
fail(){ ERRORS+=("$*"); note "FAIL: $*"; }

mkdir -p "$DEST"
chmod 700 /var/backups/pg "$DEST"

# --- verify a dump is a real archive, not just a file that got created ---------
# pg_dump can exit 0 and leave a truncated file if the disk fills mid-write. The
# only honest check is asking pg_restore to parse the table of contents back.
verify(){
  local f=$1 label=$2 where=$3
  [ -s "$f" ] || { fail "$label: dump is empty"; return 1; }
  local n
  # The container has no view of this host path, so the archive goes in on stdin.
  if [ "$where" = "container" ]; then
    n=$(docker exec -i supabase-db pg_restore -l < "$f" 2>/dev/null | grep -c '^;')
  else
    n=$(pg_restore -l "$f" 2>/dev/null | grep -c '^;')
  fi
  if [ "${n:-0}" -lt 1 ]; then fail "$label: pg_restore cannot read the archive"; return 1; fi
  note "$label: $(du -h "$f" | cut -f1), TOC readable"
  return 0
}

# --- host postgres (18.6) -----------------------------------------------------
for db in usecert orionsafe rwaexperts yamale; do
  f="$DEST/host-$db-$STAMP.dump"
  # Redirect as root: the postgres user cannot write into this 700 root-owned
  # directory, and -f made pg_dump try to open the file as postgres itself.
  if sudo -u postgres pg_dump -Fc -d "$db" > "$f" 2>>"$LOG"; then
    chmod 600 "$f"; verify "$f" "host/$db" host
  else
    fail "host/$db: pg_dump failed"
  fi
done

# --- supabase container (17.6) ------------------------------------------------
# Dumped with the CONTAINER's own pg_dump so client and server versions match.
for db in postgres _supabase; do
  f="$DEST/supabase-$db-$STAMP.dump"
  if docker exec supabase-db pg_dump -Fc -U postgres -d "$db" > "$f" 2>>"$LOG"; then
    chmod 600 "$f"
    verify "$f" "supabase/$db" container
  else
    fail "supabase/$db: pg_dump failed"
  fi
done

# --- per project ---------------------------------------------------------------
# The whole-database dump above is the AUTHORITATIVE copy and stays: it is the only
# one guaranteed to restore cross-schema objects, extensions and grants together.
# These three are for the common case - "restore one project" - where taking the
# whole database back would drag the other project's data with it.
#
# The split is by SCHEMA, verified rather than assumed: orion-safe configures
# `db: { schema: 'orion' }`, rwa-experts configures nothing and so uses `public`,
# and a cross-schema foreign-key check returns empty, which is what makes a
# schema-only dump restorable on its own.
#
# auth and storage are SHARED by both apps and belong to neither, so they are their
# own file. Restoring a project onto a fresh database needs that one too, or the
# rows survive and the users who own them do not.
for pair in "orion:orion" "qwilon:public"; do
  NAME=${pair%%:*}; SCHEMA=${pair##*:}
  f="$DEST/project-$NAME-$STAMP.dump"
  # `extensions` rides along with every project dump. Supabase puts uuid-ossp and
  # pgcrypto there, and orion's tables default their ids to gen_random_uuid() - so a
  # --schema=orion dump alone restored 5 of 17 tables with 108 errors, every one of
  # them downstream of "schema extensions does not exist". It costs a few KB and it
  # is the difference between a dump that restores and one that only looks like it.
  if docker exec supabase-db pg_dump -Fc -U postgres -d postgres        --schema="$SCHEMA" --schema=extensions > "$f" 2>>"$LOG"; then
    chmod 600 "$f"; verify "$f" "project/$NAME ($SCHEMA)" container
  else
    fail "project/$NAME: pg_dump --schema=$SCHEMA failed"
  fi
done

f="$DEST/project-shared-auth-$STAMP.dump"
if docker exec supabase-db pg_dump -Fc -U postgres -d postgres --schema=auth --schema=storage > "$f" 2>>"$LOG"; then
  chmod 600 "$f"; verify "$f" "project/shared (auth+storage)" container
else
  fail "project/shared: pg_dump of auth+storage failed"
fi

# UseCert has NO database. Its web app reads the chain and the usecert database is
# empty - so a "cert" dump of nothing would look like a backup and protect nothing.
# What it does have off-chain, and what is genuinely irreplaceable, is the address
# book: lose it and the deployed contracts are still there but nothing knows where.
# Keys are deliberately NOT included - this set is destined for offsite storage.
# A project dump restores into an EMPTY database, which has none of the Supabase
# scaffolding its tables assume. pg_dump --schema deliberately omits extensions -
# they are database-level objects, not schema members - so orion restored 5 of 17
# tables, every failure tracing back to `extensions.uuid_generate_v4() does not
# exist`. This file recreates that scaffolding, generated from the live database
# rather than hardcoded, so it stays true if the extension set changes.
f="$DEST/project-prepare-$STAMP.sql"
{
  echo "-- Run this FIRST when restoring any project-*.dump into a fresh database."
  echo "-- Generated from the live database; recreates the schemas and extensions a"
  echo "-- per-schema dump cannot carry."
  docker exec supabase-db psql -U postgres -tAc "
    SELECT 'CREATE SCHEMA IF NOT EXISTS '||quote_ident(n.nspname)||';'
    FROM pg_namespace n
    WHERE n.nspname IN ('extensions','vault','graphql','graphql_public')" 2>/dev/null
  docker exec supabase-db psql -U postgres -tAc "
    SELECT 'CREATE EXTENSION IF NOT EXISTS '||quote_ident(e.extname)||
           ' SCHEMA '||quote_ident(n.nspname)||';'
    FROM pg_extension e JOIN pg_namespace n ON n.oid=e.extnamespace
    WHERE e.extname <> 'plpgsql'" 2>/dev/null
} > "$f" 2>>"$LOG"
if [ -s "$f" ]; then
  chmod 600 "$f"; note "project/prepare: $(grep -c . "$f") statements"
else
  fail "project/prepare: could not generate the scaffolding"
fi

# UseCert runs on the France host since 2026-09-26; its state arrives here nightly as an
# encrypted archive (usecert-backup-france -> usecert-france-receive, openssl CMS to a key
# held offline). The newest one joins tonight's set so it goes offsite with everything else:
# a third copy, off both servers. It was the testnet address book from /opt/usecert, which is
# retired. Already encrypted, and the offsite remote is a crypt remote on top.
f="$DEST/project-cert-france-$STAMP.cms"
latest=$(ls -1t /var/backups/usecert-france/usecert-france-*.cms 2>/dev/null | head -1)
if [ -n "$latest" ] && [ $(( $(date +%s) - $(stat -c %Y "$latest") )) -lt 129600 ]; then
  cp "$latest" "$f"; chmod 600 "$f"
  note "project/cert: France state $(du -h "$f" | cut -f1), encrypted, from $(basename "$latest")"
else
  fail "project/cert: no France archive newer than 36 h in /var/backups/usecert-france"
fi

# --- roles and grants are not in a per-database dump --------------------------
f="$DEST/supabase-globals-$STAMP.sql"
docker exec supabase-db pg_dumpall -U postgres --globals-only > "$f" 2>>"$LOG" \
  && chmod 600 "$f" && note "supabase globals: $(du -h "$f" | cut -f1)" \
  || fail "supabase globals: pg_dumpall failed"

# --- manifest so a restorer knows what they are holding -----------------------
{
  echo "created_utc: $STAMP"
  echo "host: $(hostname)"
  echo "host_pg: $(sudo -u postgres psql -tAc 'show server_version' 2>/dev/null | head -1)"
  echo "supabase_pg: $(docker exec supabase-db psql -U postgres -tAc 'show server_version' 2>/dev/null | head -1)"
  echo "files:"
  (cd "$DEST" && sha256sum ./*"$STAMP"* 2>/dev/null | sed 's/^/  /')
} > "$DEST/MANIFEST-$STAMP.txt"

# --- offsite ------------------------------------------------------------------
if [ -n "$REMOTE" ] && command -v rclone >/dev/null; then
  if rclone copy "$DEST" "$REMOTE/$DAY" --transfers 2 --retries 3 2>>"$LOG"; then
    # Prove it landed, rather than trusting rclone's exit code.
    local_n=$(find "$DEST" -type f | wc -l)
    remote_n=$(rclone lsf "$REMOTE/$DAY" 2>/dev/null | wc -l)
    if [ "$remote_n" -ge "$local_n" ]; then
      note "offsite: $remote_n files at $REMOTE/$DAY"
    else
      fail "offsite: only $remote_n of $local_n files arrived"
    fi
    # Purge whole dated FOLDERS, not just their contents. `rclone delete --min-age`
    # removes files and leaves the empty directories behind, so the remote slowly
    # fills with hollow folders that look like backups from the Drive UI and are not.
    # Dates come from the folder NAME rather than file mtimes: an upload that was
    # retried touches mtimes and would keep resurrecting a set that should have gone.
    CUTOFF=$(date -u -d "$KEEP_LOCAL_DAYS days ago" +%Y-%m-%d)
    while read -r RDIR; do
      RDIR=${RDIR%/}
      [ -z "$RDIR" ] && continue
      case "$RDIR" in 20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]) ;; *) continue ;; esac
      if [[ "$RDIR" < "$CUTOFF" ]]; then
        if rclone purge "$REMOTE$RDIR" 2>>"$LOG"; then
          note "offsite: purged $RDIR (older than $KEEP_LOCAL_DAYS days)"
        else
          fail "offsite: could not purge $RDIR"
        fi
      fi
    done < <(rclone lsf "$REMOTE" --dirs-only 2>/dev/null)
  else
    fail "offsite: rclone copy failed"
  fi
elif [ -z "$REMOTE" ]; then
  note "offsite: not configured (no /etc/usecert/backup-remote) - LOCAL COPY ONLY"
  WARNINGS+=("offsite copy is not configured; backups exist only on the same disk as the data")
else
  fail "offsite: rclone not installed"
fi

# --- retention ----------------------------------------------------------------
# Pruned by FOLDER NAME, not mtime. A set that was re-verified, re-uploaded or even
# just listed can carry a fresh mtime and would then never age out under -mtime,
# which is how a "7 day" retention quietly becomes forever.
LOCAL_CUTOFF=$(date -u -d "$KEEP_LOCAL_DAYS days ago" +%Y-%m-%d)
for d in /var/backups/pg/20*/; do
  [ -d "$d" ] || continue
  nm=$(basename "$d")
  if [[ "$nm" < "$LOCAL_CUTOFF" ]]; then rm -rf "$d" && note "pruned local set $nm"; fi
done
note "local sets retained: $(find /var/backups/pg -maxdepth 1 -type d -name '20*' | wc -l)"

# --- report -------------------------------------------------------------------
SIZE=$(du -sh "$DEST" 2>/dev/null | cut -f1)
if [ ${#ERRORS[@]} -eq 0 ]; then
  STATUS="OK"; ICON="a"
else
  STATUS="${#ERRORS[@]} problem(s)"; ICON="!"
fi
MSG="[$ICON] <b>$(hostname)</b> database backup%0A%0Astatus: $STATUS%0Aset: $DAY ($SIZE)%0Afiles: $(find "$DEST" -type f | wc -l)"
for e in "${ERRORS[@]:-}"; do [ -n "$e" ] && MSG="$MSG%0A- $e"; done
for w in "${WARNINGS[@]:-}"; do [ -n "$w" ] && MSG="$MSG%0A- (warning) $w"; done

# Only notify on failure; a nightly success message trains you to ignore it.
if { [ ${#ERRORS[@]} -gt 0 ] || [ ${#WARNINGS[@]} -gt 0 ]; } && [ -n "${TG_TOKEN:-}" ] && [ -n "${TG_CHAT:-}" ]; then
  curl -s -m 20 -X POST "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
    -d chat_id="${TG_CHAT}" -d parse_mode=HTML --data-urlencode text="$(printf '%b' "$MSG")" >/dev/null
fi

cat "$LOG" >> /var/log/usecert-backup.log
rm -f "$LOG"
[ ${#ERRORS[@]} -eq 0 ]
