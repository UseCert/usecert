#!/usr/bin/env python3
"""What is running on the France host, and whether it is exactly what is public on GitHub.

    usecert-release-manifest        write /var/www/usecert-data/manifest.json (served at /data/manifest.json)

Hourly (usecert-release-manifest.timer). Unsigned, by the owner's decision: no release signing.
What makes it worth reading anyway is that it does not ask to be trusted about the code. Every
entry carries the git blob id of the file as deployed, computed here the way git does
(sha1 of "blob <len>\\0" + bytes), next to the blob id GitHub has for the same path on the
published branch. Anyone can recompute both: `git hash-object <file>` for one side,
`git ls-tree <branch> <path>` for the other. `matches` is true only when they are identical.

Two GitHub API calls per run (the two recursive branch trees), well inside the unauthenticated
limit of 60 an hour.
"""
import glob
import hashlib
import json
import os
import socket
import subprocess
import time
import urllib.request

REPO = "UseCert/usecert"
BACKEND = "backend/contracts-c1"
FRONTEND = "main"
OUT = "/var/www/usecert-data/manifest.json"
WEB_SRC = "/opt/usecert-web"

# host path -> (branch, repository path). Only files that come from a repository are listed; a
# host-only secret or state file has no public counterpart and is deliberately absent.
FILES = {
    "/usr/local/bin/usecert-health-mainnet": (BACKEND, "deploy/bin/usecert-health-mainnet"),
    "/usr/local/bin/usecert-history": (BACKEND, "deploy/bin/usecert-history"),
    "/usr/local/bin/usecert-indexer": (BACKEND, "deploy/bin/usecert-indexer"),
    "/usr/local/bin/usecert-backup-france": (BACKEND, "deploy/bin/usecert-backup-france"),
    "/usr/local/bin/usecert-deploy-web": (BACKEND, "deploy/bin/usecert-deploy-web"),
    "/usr/local/bin/usecert-release-manifest": (BACKEND, "deploy/bin/usecert-release-manifest"),
    "/opt/keeper/usecert-keeper.py": (BACKEND, "deploy/bin/usecert-keeper.py"),
    "/opt/keeper/usecert-signer-mainnet.py": (BACKEND, "deploy/bin/usecert-signer-mainnet.py"),
    "/opt/keeper/book-stack4.json": (BACKEND, "deployments/4663.json"),
    "/etc/nginx/snippets/usecert-data.conf": (BACKEND, "deploy/nginx/usecert-data.conf"),
    "/etc/nginx/snippets/usecert-updates.conf": (BACKEND, "deploy/nginx/usecert-updates.conf"),
    "/etc/nginx/snippets/usecert-api-attestations.conf": (BACKEND, "deploy/nginx/usecert-api-attestations.conf"),
}


def git_blob(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def tree(branch):
    url = "https://api.github.com/repos/%s/git/trees/%s?recursive=1" % (REPO, urllib.request.quote(branch, safe=""))
    req = urllib.request.Request(url, headers={"User-Agent": "usecert-release-manifest/1.0", "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        body = json.load(r)
    return body["sha"], {e["path"]: e["sha"] for e in body["tree"] if e["type"] == "blob"}


def main():
    trees = {}
    for b in (BACKEND, FRONTEND):
        try:
            trees[b] = tree(b)
        except Exception as e:                                   # noqa: BLE001
            trees[b] = (None, {})
            print("tree %s unavailable: %s" % (b, e))

    files = []
    for host, (branch, path) in FILES.items():
        try:
            data = open(host, "rb").read()
        except OSError:
            files.append({"host": host, "repo": "%s:%s" % (branch, path), "present": False, "matches": False})
            continue
        mine = git_blob(data)
        theirs = trees[branch][1].get(path)
        files.append({"host": host, "repo": "%s:%s" % (branch, path), "sha256": hashlib.sha256(data).hexdigest(),
                      "blob": mine, "repoBlob": theirs, "matches": theirs == mine})

    # The site: every source file the running build was compiled from, against the front-end
    # branch. A src file that differs, or exists on only one side, is listed by name.
    web = {"branch": FRONTEND, "commit": trees[FRONTEND][0]}
    repo_src = {p: s for p, s in trees[FRONTEND][1].items() if p.startswith(("src/", "public/"))}
    mine_src = {}
    for top in ("src", "public"):
        for f in glob.glob(os.path.join(WEB_SRC, top, "**", "*"), recursive=True):
            if os.path.isfile(f):
                mine_src[os.path.relpath(f, WEB_SRC).replace(os.sep, "/")] = git_blob(open(f, "rb").read())
    differ = sorted(p for p in mine_src if repo_src.get(p) != mine_src[p])
    only_repo = sorted(p for p in repo_src if p not in mine_src)
    web.update(files=len(mine_src), matching=len(mine_src) - len(differ), differ=differ[:50],
               onlyInRepo=only_repo[:50], matches=not differ and not only_repo)
    try:
        nitro = json.load(open(os.path.join(WEB_SRC, ".output", "nitro.json")))
        web["build"] = {"preset": nitro.get("preset"), "date": nitro.get("date")}
    except (OSError, ValueError):
        pass

    doc = {
        "generatedAt": int(time.time()),
        "host": socket.gethostname(),
        "signed": False,
        "howToCheck": "Each 'blob' is `git hash-object` of the deployed file; 'repoBlob' is GitHub's blob for the same path on the named branch. Equal means byte-identical.",
        "backend": {"branch": BACKEND, "commit": trees[BACKEND][0]},
        "files": files,
        "web": web,
        "allMatch": all(f["matches"] for f in files) and web["matches"],
    }
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    json.dump(doc, open(OUT + ".tmp", "w"), indent=1)
    os.replace(OUT + ".tmp", OUT)
    bad = [f["host"] for f in files if not f["matches"]]
    print("manifest: %d/%d files match, web %d/%d src files match%s" % (
        len(files) - len(bad), len(files), web["matching"], web["files"],
        "" if not bad and web["matches"] else "; differ: %s" % (bad + differ + only_repo)[:8]))


if __name__ == "__main__":
    main()
