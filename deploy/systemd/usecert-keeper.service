[Unit]
Description=UseCert hedge keeper (opens hedges off chain, settles keeper-mode mints)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keeper
Group=keeper
# The attester key, read by systemd as root and handed to the process; the file stays root-only.
EnvironmentFile=/etc/usecert-keeper/attester.env
ExecStart=/opt/keeper/venv/bin/python /opt/keeper/usecert-keeper.py /opt/keeper/keeper.json
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/keeper
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=append:/var/log/usecert-keeper.log
StandardError=append:/var/log/usecert-keeper.log

[Install]
WantedBy=multi-user.target
