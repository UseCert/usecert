[Unit]
Description=UseCert stack 5: the settler on Montreal - checks each France keeper request against its own chain and venue reads, then signs (Sermium M-03)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=usecert
Group=usecert-settle
# SETTLER_PK and SETTLER_ADDR, root-only; read by systemd, never on a command line.
EnvironmentFile=/etc/usecert/settler-remote.env
ExecStart=/opt/usecert-s5/venv/bin/python /opt/usecert/deploy/bin/usecert-settler-remote serve
Restart=always
RestartSec=5
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/usecert-settler
ProtectHome=true
PrivateTmp=true
StandardOutput=append:/var/log/usecert-settler-remote.log
StandardError=append:/var/log/usecert-settler-remote.log

[Install]
WantedBy=multi-user.target
